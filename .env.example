# Export these variables in your service manager; this app does not load .env automatically.
WEBHOOK_SECRET=replace-with-a-random-webhook-secret
GITHUB_TOKEN=replace-with-your-fine-grained-pat
ALLOWED_REPOS=owner/repository
REVIEWER_ID=replace-with-your-numeric-github-user-id
DATA_DIR=./data
PORT=8787
PI_IMAGE=pr-review-pi:local
PI_MODEL=choose-an-available-copilot-model
PI_AUTH_DIR=./pi-auth
